{
  "sandbox": {
    "enabled": true,
    "allowScripts": true,
    "allowForms": true,
    "allowModals": false,
    "allowPopups": false,
    "allowSameOrigin": true,
    "allowTopNavigation": false
  },
  "certificateValidation": {
    "enabled": true,
    "allowSelfSigned": false,
    "allowExpired": false,
    "allowRevoked": false,
    "minKeySize": 2048
  },
  "permissions": {
    "notifications": "ask",
    "geolocation": "ask",
    "microphone": "ask",
    "camera": "ask",
    "clipboard": "ask",
    "popups": "block"
  },
  "contentSecurity": {
    "enabled": true,
    "defaultSrc": "'self'",
    "scriptSrc": "'self' 'unsafe-inline'",
    "styleSrc": "'self' 'unsafe-inline'",
    "imgSrc": "* data: blob:",
    "connectSrc": "'self' ws: wss:",
    "fontSrc": "'self'",
    "objectSrc": "'none'",
    "mediaSrc": "'self'",
    "frameSrc": "'self'",
    "baseUri": "'self'",
    "formAction": "'self'"
  },
  "allowedSchemes": [
    "http",
    "https",
    "ftp",
    "ftps",
    "sftp",
    "ws",
    "wss",
    "file",
    "data",
    "blob",
    "mailto",
    "tel",
    "sms",
    "ssh",
    "magnet",
    "http-proxy",
    "https-proxy",
    "socks4",
    "socks4a",
    "socks5",
    "pac+http",
    "pac+https",
    "wpad",
    "dns",
    "dns+udp",
    "dns+tcp",
    "https+dns",
    "tls+dns",
    "quic+dns",
    "dnssec",
    "mdns",
    "ssh-tunnel",
    "wg",
    "openvpn",
    "ipsec",
    "ikev2",
    "l2tp",
    "gre",
    "ipip",
    "vxlan",
    "geneve",
    "6to4",
    "isatap",
    "teredo",
    "upnp",
    "nat-pmp",
    "pcp",
    "stun",
    "stuns",
    "turn",
    "turns",
    "ice",
    "captive",
    "radius",
    "radiustls",
    "tacacs",
    "dot1x",
    "wispr",
    "health",
    "consul",
    "cdn",
    "cdn+push",
    "cdn+pull",
    "ssdp",
    "bonjour",
    "avahi",
    "dnssd"
  ]
}
