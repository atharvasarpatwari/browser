# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is gitignored — never commit it or the .jks file it points to.
# See doc/android-release-signing.md for how to generate the keystore itself.

storeFile=../nova-release.jks
storePassword=CHANGE_ME
keyAlias=nova
keyPassword=CHANGE_ME
