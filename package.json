{
  "name": "nova-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Nova Browser — A TypeScript browser engine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:web": "vite build",
    "preview": "vite preview --port 4173",
    "start": "vite preview --port 4173",
    "android": "cap android",
    "build:android": "vite build && cap sync android",
    "open:android": "cap open android",
    "watch": "tsc --watch",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --check src/ tests/",
    "format:fix": "prettier --write src/ tests/",
    "benchmark": "tsx src/benchmark/run.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.4.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "webgpu": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@webgpu/types": "^0.1.71",
    "eslint": "^8.57.0",
    "happy-dom": "^20.10.6",
    "http-server": "^14.1.1",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
